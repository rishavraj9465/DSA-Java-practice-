class Solution {
    public static int largestElement(int[] nums) {

     int largest = Integer.MIN_VALUE;

     for(int i=0; i<nums.length; i++){
        if(largest<nums[i]){
            largest=nums[i];
        }
     }
     return largest;

    }

    public static void main(String args[]){
        int nums [] = {3,3,6,1};
        System.out.println("Largest value is " + largestElement(nums));
    }
}

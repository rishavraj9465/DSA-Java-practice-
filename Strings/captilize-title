class Solution {
    public String capitalizeTitle(String title) {
        char[] chars = title.toCharArray();
        int n = chars.length;

        for (int i = 0; i < n; i++) {
            int start = i;

            // Lowercase every character in the current word
            while (i < n && chars[i] != ' ') {
                chars[i] = Character.toLowerCase(chars[i]);
                i++;
            }

            // If the word length is 3 or more, capitalize its first letter
            if (i - start > 2) {
                chars[start] = Character.toUpperCase(chars[start]);
            }
        }

        return new String(chars);
    }
}
